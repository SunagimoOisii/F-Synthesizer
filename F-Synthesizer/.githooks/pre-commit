#!/usr/bin/env sh

# Keep auto-generated docs in sync only when architecture-related files are staged.
staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
needs_auto_update=0
for f in $staged_files; do
  case "$f" in
    F-Synthesizer/src/*|F-Synthesizer/include/*|F-Synthesizer/scripts/check.ps1)
      needs_auto_update=1
      break
      ;;
  esac
done

if [ $needs_auto_update -eq 0 ]; then
  exit 0
fi

pwsh -NoProfile -ExecutionPolicy Bypass -File "F-Synthesizer/scripts/check.ps1" -SkipBuild -SkipRun -DocRules off
status=$?
if [ $status -ne 0 ]; then
  echo "pre-commit: check.ps1 failed" >&2
  exit $status
fi

# Include auto-updated docs in the commit.
git add F-Synthesizer/docs/Architecture.md

exit 0
